<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Taskaway</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>taskaway</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.taskaway.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>taskaway</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Supabase Auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.taskawayasia</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to take photos for task documentation.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location to show nearby tasks and send notifications when you're near tasks you've offered on. Your location is checked periodically (every 30 minutes) when you're available for tasks, and is never shared without your permission.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Taskaway only requests "When In Use" location access and never requires "Always Allow" permission. This description is required because some third-party SDKs (Firebase, Maps) reference location APIs, but the app will never request background location access. Your location is only used when you're actively using the app to show nearby tasks.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs photo library access to select images for task documentation.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This app uses tracking data to provide personalized recommendations and improve your experience. Your data helps us connect you with relevant tasks and services in your area.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Firebase Cloud Messaging / APNs Configuration -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<!-- Disable Firebase swizzling to handle notifications manually -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
</dict>
</plist>
